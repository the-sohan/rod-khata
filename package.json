    "build:android": "node scripts/build-android.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "start:demo": "node scripts/run-demo.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
