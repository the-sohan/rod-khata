{
  "name": "rod-shop-local",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "apps/pc",
    "apps/owner"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs",
    "build": "node scripts/build.mjs",
